{
  "name": "@belmont/cli",
  "version": "1.0.0",
  "description": "Belmont CLI — the `belmont` launcher. Resolves project root, execs pi with the Belmont extension preloaded, plus init/install/update/validate/status subcommands.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "belmont": "./dist/bin/belmont.js"
  },
  "files": ["dist/", "bin/"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blakesimpson/belmont.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/blakesimpson/belmont#readme",
  "bugs": {
    "url": "https://github.com/blakesimpson/belmont/issues"
  },
  "keywords": [
    "belmont",
    "cli",
    "pi-coding-agent",
    "ai-coding",
    "auto-mode",
    "mcp"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@belmont/harness": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
