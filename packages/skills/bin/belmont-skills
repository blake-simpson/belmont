#!/usr/bin/env node
// Standalone installer entrypoint. Re-exports the runCli() shipped in
// dist/installer.js so that `npx @belmont/skills install` works without
// the user having to know the dist path.

import { runCli } from "../dist/installer.js";

runCli(process.argv.slice(2))
  .then((code) => process.exit(code))
  .catch((err) => {
    console.error(err);
    process.exit(1);
  });
