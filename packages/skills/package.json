{
  "name": "@belmont/skills",
  "version": "1.0.0",
  "description": "Belmont skills — canonical SKILL.md sources + composer + standalone installer (`npx @belmont/skills install`). Depends only on @belmont/knowledge-schema.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "belmont-skills": "bin/belmont-skills"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/", "src/", "bin/"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blakesimpson/belmont.git",
    "directory": "packages/skills"
  },
  "homepage": "https://github.com/blakesimpson/belmont#readme",
  "bugs": {
    "url": "https://github.com/blakesimpson/belmont/issues"
  },
  "keywords": [
    "belmont",
    "skills",
    "agentskills",
    "claude-code",
    "codex",
    "ai-coding"
  ],
  "dependencies": {
    "@belmont/knowledge-schema": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
